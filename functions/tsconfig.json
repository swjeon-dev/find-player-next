{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["es2020"],
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "lib",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@common": ["../common"],
      "@common/*": ["../common/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib", "_common"]
}
